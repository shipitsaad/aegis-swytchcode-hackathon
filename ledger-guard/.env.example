# Groq (free LLM) - https://console.groq.com -> API Keys
GROQ_API_KEY=your-groq-key-here

# Swytchcode CLI - leave as "swy" if it's on your PATH (it should be after setup).
# Only change this if `swy` isn't found when running the app.
# NOTE: intentionally not named SWYTCHCODE_BIN - the CLI itself reads that exact name
# internally and setting it causes a self-referential launch collision.
# Always use AEGIS_SWY_BIN here instead.
AEGIS_SWY_BIN=swy

# PayPal sandbox - https://developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
# We use these to fetch our own bearer token directly (bypasses Swytchcode's paid-plan
# gate for PayPal).
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-secret

# Slack channel to post updates to (your workspace's real channel ID)
SLACK_CHANNEL_ID=your-slack-channel-id

# Notion database ID for the ledger
NOTION_DATABASE_ID=your-notion-database-id

# Jira project to file Leak Radar tickets in - the project KEY (not name), e.g. SCRUM.
# Find it via `swy exec jira.api.project.list7 --json` after connecting.
JIRA_PROJECT_KEY=your-jira-project-key
# The issue type ID to file tickets as (a plain "Task" works fine). Find via
# `swy exec jira.api.project.list3 --json` with your projectId.
JIRA_TASK_ISSUE_TYPE_ID=10003
